#!/bin/bash
# Kept for habit: people's passwords are set with set-password (nas area), which writes LLDAP and the
# NAS (Samba) together so they never drift. Installed to /usr/local/sbin by auth/hook.sh.
# Usage: ssh -t sercan@192.168.0.222 sudo set-ldap-password <user>
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
[ -x /usr/local/sbin/set-password ] || { echo "set-password yok: önce nas alanını deploy edin."; exit 1; }
exec /usr/local/sbin/set-password "$@"
