#!/bin/bash
# A person's login password (LLDAP: Authelia, so Immich, Home Assistant, Paperless, Proxmox).
# People have no NAS account, so this is their only password; NAS (Samba) passwords of the service
# accounts are set with set-password (nas area). Installed to /usr/local/sbin by auth/hook.sh.
# Usage: ssh -t sercan@192.168.0.222 sudo set-ldap-password <user>
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
U=${1:-}
[[ $U =~ ^[a-z][a-z0-9._-]*$ ]] || { echo "Kullanım: set-ldap-password <kullanıcı>  (örn. melike)"; exit 1; }
read -rsp "$U için yeni giriş şifresi: " P1; echo
read -rsp "Tekrar: " P2; echo
[ "$P1" = "$P2" ] || { echo "Şifreler aynı değil, değiştirilmedi."; exit 1; }
[ ${#P1} -ge 12 ] || { echo "En az 12 karakter olmalı, değiştirilmedi."; exit 1; }
# The new password goes in through the environment, not on a command line.
ADMIN=$(sed -n 's/^LLDAP_LDAP_USER_PASS=//p' /opt/secrets/auth.env)
export LLDAP_USER_PASSWORD=$P1
if ! docker exec -e LLDAP_USER_PASSWORD auth-lldap-1 /app/lldap_set_password --base-url http://localhost:17170 \
     --admin-username admin --admin-password "$ADMIN" --username "$U" >/dev/null; then
  echo "LLDAP şifresi ayarlanamadı ($U LLDAP'ta var mı?)."; exit 1
fi
echo "Giriş şifresi ayarlandı: $U"
