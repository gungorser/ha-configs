#!/bin/bash
# Sets an LLDAP user's password without echoing it (installed to /usr/local/sbin by auth/hook.sh).
# Usage from Sercan's PC: ssh -t sercan@192.168.0.222 sudo set-ldap-password <user>
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
U=${1:-}
[[ $U =~ ^[a-z][a-z0-9._-]*$ ]] || { echo "Kullanım: set-ldap-password <kullanıcı>  (örn. sercan)"; exit 1; }
read -rsp "$U için yeni şifre: " P1; echo
read -rsp "Tekrar: " P2; echo
[ "$P1" = "$P2" ] || { echo "Şifreler aynı değil, değiştirilmedi."; exit 1; }
[ ${#P1} -ge 12 ] || { echo "En az 12 karakter olmalı, değiştirilmedi."; exit 1; }
ADMIN=$(sed -n 's/^LLDAP_LDAP_USER_PASS=//p' /opt/secrets/auth.env)
# The new password goes in through the environment (docker exec -e NAME copies it from here), not
# on a command line; the admin password stays inside the container's process table (root only).
export LLDAP_USER_PASSWORD=$P1
docker exec -e LLDAP_USER_PASSWORD auth-lldap-1 /app/lldap_set_password --base-url http://localhost:17170 \
  --admin-username admin --admin-password "$ADMIN" --username "$U" >/dev/null
echo "Şifre değiştirildi: $U"
