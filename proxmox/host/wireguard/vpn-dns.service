# dnsmasq answering VPN clients on 10.8.0.1 (proxmox area).
[Unit]
Description=DNS for WireGuard VPN clients
After=wg-quick@wg0.service
BindsTo=wg-quick@wg0.service

[Service]
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/etc/wireguard/dnsmasq-vpn.conf --pid-file=
Restart=on-failure

[Install]
WantedBy=wg-quick@wg0.service
