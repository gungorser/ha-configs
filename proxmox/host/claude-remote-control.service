[Unit]
Description=Claude Code Remote Control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=claude
Group=claude
WorkingDirectory=/home/claude/work
Environment=HOME=/home/claude
Environment=TERM=xterm-256color
Environment=PATH=/home/claude/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# remote-control expects a TTY; script(1) provides a pseudo-terminal
ExecStart=/usr/bin/script -qfc "/home/claude/.local/bin/claude remote-control" /dev/null
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
