#!/bin/bash
# NAS (Samba) password. People who are in LLDAP get both passwords at once through set-password, so
# the two never drift; only service accounts without an LLDAP login (ha-backup) are set here alone.
# Installed to /usr/local/sbin by nas/hook.sh.
# Usage: ssh -t sercan@192.168.0.222 sudo set-smb-password <user>   (people: use set-password)
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
U=${1:-}
[[ $U =~ ^[a-z][a-z0-9._-]*$ ]] || { echo "Kullanım: set-smb-password <kullanıcı>  (kişiler için: set-password)"; exit 1; }
if grep -qsh "\"id\": *\"$U\"" /opt/stacks/auth/lldap-bootstrap/user-configs/*.json; then
  echo "$U bir LLDAP kullanıcısı: şifre set-password ile LLDAP ve NAS için birlikte ayarlanır."
  exec /usr/local/sbin/set-password "$U"
fi
docker exec nas-samba-1 getent passwd "$U" >/dev/null || { echo "$U NAS'ta tanımlı değil."; exit 1; }
read -rsp "$U için NAS şifresi: " P1; echo
read -rsp "Tekrar: " P2; echo
[ "$P1" = "$P2" ] || { echo "Şifreler aynı değil, değiştirilmedi."; exit 1; }
[ ${#P1} -ge 12 ] || { echo "En az 12 karakter olmalı, değiştirilmedi."; exit 1; }
printf '%s\n%s\n' "$P1" "$P1" | docker exec -i nas-samba-1 smbpasswd -s -a "$U" >/dev/null
echo "NAS şifresi ayarlandı: $U"
