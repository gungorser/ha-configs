#!/bin/bash
# NAS (Samba) password only, for any NAS account (people from the LLDAP lists, ha-media, ha-backup).
# It does not touch LLDAP: LLDAP keeps OPAQUE hashes that Samba cannot use, so the login password
# (Authelia) is separate and set in the LLDAP UI.
# Installed to /usr/local/sbin by nas/hook.sh.
# Usage: ssh -t sercan@192.168.0.222 sudo set-password <user>
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
U=${1:-}
[[ $U =~ ^[a-z][a-z0-9._-]*$ ]] || { echo "Kullanım: set-password <kullanıcı>  (örn. sercan, ha-media)"; exit 1; }
if ! awk -v u="$U" '$1 == "user" && $2 == u {f=1} END {exit !f}' /srv/data/nas/accounts 2>/dev/null; then
  echo "$U NAS'ta tanımlı değil (sadece repo listesindeki kişiler ve servis hesapları). Giriş şifresi LLDAP arayüzünden değişir."
  exit 1
fi
read -rsp "$U için NAS şifresi: " P1; echo
read -rsp "Tekrar: " P2; echo
[ "$P1" = "$P2" ] || { echo "Şifreler aynı değil, değiştirilmedi."; exit 1; }
[ ${#P1} -ge 12 ] || { echo "En az 12 karakter olmalı, değiştirilmedi."; exit 1; }
printf '%s\n%s\n' "$P1" "$P1" | docker exec -i nas-samba-1 smbpasswd -s -a "$U" >/dev/null
echo "NAS şifresi ayarlandı: $U"
