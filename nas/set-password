#!/bin/bash
# Sets a person's password once for both logins: LLDAP (portal, Authelia, Paperless, HA, ...) and
# the NAS (Samba). Samba cannot check LLDAP passwords (LLDAP never sees them: OPAQUE), so both are
# written here from one prompt. Change passwords only with this command, not in the LLDAP web UI.
# Installed to /usr/local/sbin by nas/hook.sh.
# Usage: ssh -t sercan@192.168.0.222 sudo set-password <user>
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
U=${1:-}
[[ $U =~ ^[a-z][a-z0-9._-]*$ ]] || { echo "Kullanım: set-password <kullanıcı>  (örn. sercan)"; exit 1; }
read -rsp "$U için yeni şifre: " P1; echo
read -rsp "Tekrar: " P2; echo
[ "$P1" = "$P2" ] || { echo "Şifreler aynı değil, değiştirilmedi."; exit 1; }
[ ${#P1} -ge 12 ] || { echo "En az 12 karakter olmalı, değiştirilmedi."; exit 1; }

# LLDAP: the new password goes in through the environment, not on a command line.
ADMIN=$(sed -n 's/^LLDAP_LDAP_USER_PASS=//p' /opt/secrets/auth.env)
export LLDAP_USER_PASSWORD=$P1
if ! docker exec -e LLDAP_USER_PASSWORD auth-lldap-1 /app/lldap_set_password --base-url http://localhost:17170 \
     --admin-username admin --admin-password "$ADMIN" --username "$U" >/dev/null; then
  echo "LLDAP şifresi ayarlanamadı ($U LLDAP'ta var mı?). Hiçbir şey değişmedi."; exit 1
fi
echo "LLDAP şifresi ayarlandı: $U"

# NAS (Samba), only for NAS accounts (written from the LLDAP lists by nas/hook.sh).
if awk -v u="$U" '$1 == "user" && $2 == u {f=1} END {exit !f}' /srv/data/nas/accounts 2>/dev/null; then
  printf '%s\n%s\n' "$P1" "$P1" | docker exec -i nas-samba-1 smbpasswd -s -a "$U" >/dev/null
  echo "NAS şifresi ayarlandı: $U"
else
  echo "Not: $U NAS'ta tanımlı değil, sadece LLDAP şifresi ayarlandı."
fi
