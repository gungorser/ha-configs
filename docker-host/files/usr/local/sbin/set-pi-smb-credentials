#!/bin/bash
# Asks for the Pi's Samba login (Samba NAS add-on) without echoing the password and writes
# /opt/secrets/pi-smb.cred (600 root, smbclient/mount.cifs credentials format). Used once to copy
# the Paperless add-on's data from the Pi; delete the file after the migration.
set -euo pipefail
[ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"
read -rp "Pi Samba kullanıcı adı: " U
read -rsp "Pi Samba şifresi: " P; echo
[ -n "$U" ] && [ -n "$P" ] || { echo "Boş bırakılamaz, kaydedilmedi."; exit 1; }
umask 077
printf 'username=%s\npassword=%s\n' "$U" "$P" > /opt/secrets/pi-smb.cred.new
chown root:root /opt/secrets/pi-smb.cred.new && mv /opt/secrets/pi-smb.cred.new /opt/secrets/pi-smb.cred
echo "Kaydedildi: /opt/secrets/pi-smb.cred"
